#!/usr/bin/env bash
# Keeps the auto-generated sections of README.md in sync with the repo.
# Installed via `git config core.hooksPath .githooks` (see .envrc).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! python3 scripts/update-readme.py; then
    echo "pre-commit: failed to regenerate README.md" >&2
    exit 1
fi

if ! git diff --quiet -- README.md; then
    git add README.md
    echo "pre-commit: README.md was out of date and has been regenerated and staged."
    echo "pre-commit: review the changes and commit again."
    exit 1
fi

exit 0
